{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "com.devrunner.remote-runner",
  "productName": "Remote Runner",
  "version": "0.3.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Remote Runner",
        "decorations": false,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGOUIzNEFCODRFOTE4ODMKUldTREdPbUVxelNiandxMlMxbm5EbnUrN3ZXekFEaXFIeUYvcHhxeTNaOHNVTUNzYzE5VkhrQS8K",
      "endpoints": [
        "https://github.com/whoarei/remote-runner/releases/latest/download/latest.json"
      ]
    }
  }
}
